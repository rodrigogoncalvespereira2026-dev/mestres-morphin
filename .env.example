# Copia este ficheiro para `.env.local` e preenche com a tua chave.
# NUNCA comites o `.env.local` — contém segredos.
#
# Qualquer fornecedor compatível com a API da OpenAI funciona:
#   OpenAI        -> https://api.openai.com/v1        (modelo p.ex. gpt-4o-mini)
#   OpenRouter    -> https://openrouter.ai/api/v1     (modelo p.ex. openai/gpt-4o-mini)
#   Groq          -> https://api.groq.com/openai/v1   (modelo p.ex. llama-3.3-70b-versatile)
#   Ollama (local)-> http://localhost:11434/v1        (modelo p.ex. llama3.2)

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
